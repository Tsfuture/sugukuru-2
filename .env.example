# Vite Frontend Environment Variables
# Copy this file to .env.local and fill in your actual values

# Stripe Publishable Key (safe for frontend)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Supabase Configuration
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# 本番アプリURL（Cloudflare Pages）
# フロントエンド用 - Viteで使用
VITE_PUBLIC_APP_URL=https://sugukuru-2.pages.dev

# Backend Scripts Environment Variables (for onboard-facility.ts)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
APP_BASE_URL=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_FROM=

# Cloudflare Pages本番URL（QRコードのリンク先として使用）
# scripts/onboard-facility.ts で参照
# 未設定の場合はデフォルト値 https://sugukuru-2.pages.dev が使用されます
CLOUDFLARE_PROD_ORIGIN=https://sugukuru-2.pages.dev
